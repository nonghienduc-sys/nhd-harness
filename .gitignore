# Public source repo: allowlist. Everything at top level is ignored unless listed below.
/*
!/.github/
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/package.json
!/package-lock.json
!/tsconfig.json
!/electron-builder.lite.cjs
!/src/
!/test/
!/dashboard/
!/docs/
!/electron/
!/scripts/
!/browser-extension/
!/office/
!/isolated-agent/
!/registry/
!/skills/
!/workers/
!/distribution/

# Never commit inside allowed folders
node_modules/
dist/
*.bak
*.bak-*
*.pre-*
*.log
*.sqlite
*.sqlite-*
*.db
.env*
*.pem
*.key
*.pfx
*.p12
__pycache__/
*.pyc

# scripts/: only the ones the code, tests and release process use (others are one-off machine-specific ops)
/scripts/*
!/scripts/admin-document-layout-fixture.mjs
!/scripts/admin-docx-backend.mjs
!/scripts/atomic-release.mjs
!/scripts/build-admin-skill-registry.mjs
!/scripts/cutover-atomic-release.ps1
!/scripts/generate-admin-docx-fixtures.mjs
!/scripts/generate-architecture-docs.mjs
!/scripts/install-service-user.ps1
!/scripts/install-service.cjs
!/scripts/lite-package-audit.mjs
!/scripts/prepare-lite-cloudflared.ps1
!/scripts/prepare-lite-python.ps1
!/scripts/prepare-lite-release.ps1
!/scripts/publish-lite-github.ps1
!/scripts/qa_admin_pdf_geometry.py
!/scripts/restart-electron-control-plane-v0241.ps1
!/scripts/setup-isolated-agent.ps1
!/scripts/smoke-atomic-release.ps1
!/scripts/smoke-lite-ui.mjs
!/scripts/smoke-lite.mjs
!/scripts/uninstall-service.cjs

# Downloaded third-party slide templates: redistribution rights unclear
/skills/scientific-research-slide-style/assets/
